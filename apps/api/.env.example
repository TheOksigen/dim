APP_ENV=development
HTTP_ADDR=:8080
# Use a reachable PostgreSQL URL. Coolify injects the production value.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/postgres?sslmode=disable
REDIS_URL=redis://localhost:6379/0
API_MAX_DB_CONNS=32
API_MIN_DB_CONNS=4
API_DB_TIMEOUT=180ms
API_REQUEST_TIMEOUT=2s
API_MAX_BODY_BYTES=1024
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW=1m
API_CACHE_TTL=15m
API_NEGATIVE_CACHE_TTL=30s
API_CORS_ORIGINS=http://localhost:3000
